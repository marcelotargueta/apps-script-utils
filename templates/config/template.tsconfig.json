{
  "compilerOptions": {
    "target": "ESNext",
    "module": "None",
    "lib": ["ESNext"],
    "rootDir": "./src",
    "outDir": "./app",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["@types/google-apps-script"]
  },
  "include": ["src/**/*"]
}
